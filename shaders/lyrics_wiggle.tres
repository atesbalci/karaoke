[resource]
code = "shader_type canvas_item;
render_mode blend_mix;


// Varyings
varying float var_vertex_x;

uniform vec4 ProgressColor : source_color;
uniform float Progress : hint_range(0.0, 1000.0);




// 3D Noise with friendly permission by Inigo Quilez
vec3 hash_noise_range( vec3 p ) {
	p *= mat3(vec3(127.1, 311.7, -53.7), vec3(269.5, 183.3, 77.1), vec3(-301.7, 27.3, 215.3));
	return 2.0 * fract(fract(p)*4375.55) -1.;
}


void vertex() {
// Input:9
	vec2 n_out9p0 = VERTEX;
	float n_out9p1 = n_out9p0.r;
	float n_out9p2 = n_out9p0.g;


// Input:6
	int n_out6p0 = INSTANCE_ID;


// RandomRange:5
	float n_in5p1 = 0.00000;
	float n_in5p2 = 50.00000;
	float n_out5p0 = mix(n_in5p1, n_in5p2, hash_noise_range(vec3(float(n_out6p0))).x);


// Input:4
	float n_out4p0 = TIME;


// FloatOp:7
	float n_in7p1 = 5.00000;
	float n_out7p0 = n_out4p0 * n_in7p1;


// FloatOp:12
	float n_out12p0 = n_out5p0 + n_out7p0;


// FloatFunc:8
	float n_out8p0 = sin(n_out12p0);


// FloatOp:13
	float n_in13p1 = 5.00000;
	float n_out13p0 = n_out8p0 * n_in13p1;


// FloatOp:10
	float n_out10p0 = n_out9p2 + n_out13p0;


// VectorCompose:11
	vec2 n_out11p0 = vec2(n_out9p1, n_out10p0);


// Output:0
	VERTEX = n_out11p0;


// Input:2
	vec2 n_out2p0 = VERTEX;


// VaryingSetter:3
	var_vertex_x = n_out2p0.x;


}

void fragment() {
// Input:8
	vec4 n_out8p0 = COLOR;


// ColorParameter:2
	vec4 n_out2p0 = ProgressColor;


// VectorOp:10
	vec4 n_out10p0 = n_out8p0 * n_out2p0;


// VaryingGetter:9
	float n_out9p0 = var_vertex_x;


// FloatParameter:3
	float n_out3p0 = Progress;


// Step:7
	float n_out7p0 = step(n_out9p0, n_out3p0);


// Mix:4
	vec4 n_out4p0 = mix(n_out8p0, n_out10p0, n_out7p0);


// Output:0
	COLOR.rgb = vec3(n_out4p0.xyz);


}
"
