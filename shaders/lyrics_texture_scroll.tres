[resource]
code = "shader_type canvas_item;
render_mode blend_mix;


// Varyings
varying float var_vertex_x;

uniform sampler2D Texture : repeat_enable;
uniform vec4 ProgressColor : source_color;
uniform float Progress : hint_range(0.0, 1000.0);



void vertex() {
// Input:2
	vec2 n_out2p0 = VERTEX;


// VaryingSetter:3
	var_vertex_x = n_out2p0.x;


}

void fragment() {
// Input:18
	vec4 n_out18p0 = COLOR;


// Input:14
	float n_out14p0 = TIME;


// FloatOp:15
	float n_in15p1 = -1.00000;
	float n_out15p0 = n_out14p0 * n_in15p1;


// VaryingGetter:9
	float n_out9p0 = var_vertex_x;


// FloatOp:13
	float n_in13p0 = 0.01000;
	float n_out13p0 = n_in13p0 * n_out9p0;


// FloatOp:16
	float n_out16p0 = n_out15p0 + n_out13p0;


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(Texture, vec2(n_out16p0));


// ColorParameter:2
	vec4 n_out2p0 = ProgressColor;


// FloatParameter:3
	float n_out3p0 = Progress;


// Step:7
	float n_out7p0 = step(n_out9p0, n_out3p0);


// Mix:4
	vec4 n_out4p0 = mix(n_out11p0, n_out2p0, n_out7p0);


// VectorOp:17
	vec4 n_out17p0 = n_out18p0 * n_out4p0;


// Output:0
	COLOR.rgb = vec3(n_out17p0.xyz);


}
"
